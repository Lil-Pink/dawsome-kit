// Marimba: part of dawsome-kit, written by build.py.
// From Versilian Community Sample Library (VCSL), at a pinned commit; CC0-1.0, see set.json.
// Uses only the SFZ opcodes Dawsome reads; keys are MIDI numbers (C4 = 60).

<control>
default_path=samples/

<global>
loop_mode=one_shot

<region> sample=Marimba_hit_Outrigger_F1_soft_01.flac lokey=36 hikey=44 pitch_keycenter=41 lovel=1 hivel=42 volume=-9.20
<region> sample=Marimba_hit_Outrigger_F1_med_01.flac lokey=36 hikey=44 pitch_keycenter=41 lovel=43 hivel=84 volume=-5.68
