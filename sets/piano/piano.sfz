// Upright Piano: part of dawsome-kit, written by build.py.
// From FreePats Upright Piano KW, version 2022-02-21 (SFZ + FLAC); CC0-1.0, see set.json.
// Uses only the SFZ opcodes Dawsome reads; keys are MIDI numbers (C4 = 60).

<control>
default_path=samples/

<global>
volume=-1.05
ampeg_release=0.6

