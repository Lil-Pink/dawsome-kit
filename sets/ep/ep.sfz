<region> sample=F#2v100.flac lokey=39 hikey=44 pitch_keycenter=42 lovel=110
<region> sample=C3v100.flac lokey=45 hikey=50 pitch_keycenter=48 lovel=110
<region> sample=F#3v100.flac lokey=51 hikey=56 pitch_keycenter=54 lovel=110
