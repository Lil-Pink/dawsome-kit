// Electric Bass: part of dawsome-kit, written by build.py.
// From FreePats Bass Guitar YR, finger variation, version 2019-09-30 (SFZ + FLAC); CC0-1.0, see set.json.
// Uses only the SFZ opcodes Dawsome reads; keys are MIDI numbers (C4 = 60).

<control>
default_path=samples/

<global>
volume=-1.01
ampeg_release=0.5

<region> sample=E.flac lokey=26 hikey=28 pitch_keycenter=28
<region> sample=F.flac lokey=29 hikey=29 pitch_keycenter=29
<region> sample=F#.flac lokey=30 hikey=30 pitch_keycenter=30
<region> sample=G.flac lokey=31 hikey=31 pitch_keycenter=31
<region> sample=G#.flac lokey=32 hikey=32 pitch_keycenter=32
<region> sample=A.flac lokey=33 hikey=33 pitch_keycenter=33
<region> sample=A#.flac lokey=34 hikey=34 pitch_keycenter=34
<region> sample=B.flac lokey=35 hikey=35 pitch_keycenter=35
<region> sample=C.flac lokey=36 hikey=36 pitch_keycenter=36
<region> sample=C#.flac lokey=37 hikey=37 pitch_keycenter=37
<region> sample=D.flac lokey=38 hikey=38 pitch_keycenter=38
<region> sample=D#.flac lokey=39 hikey=45 pitch_keycenter=39
