// Electric Guitar: part of dawsome-kit, written by build.py.
// From FreePats FSBS Electric Guitar Clean #1, version 2026-08-07, bridge pickup (SFZ + FLAC); CC0-1.0, see set.json.
// Uses only the SFZ opcodes Dawsome reads; keys are MIDI numbers (C4 = 60).

<control>
default_path=samples/

<global>
ampeg_release=0.3

<region> sample=C2_s1_soft_01.flac lokey=35 hikey=38 pitch_keycenter=36 hivel=92 volume=-6.23
