// Acoustic Drums: part of dawsome-kit, written by build.py.
// From Karoryfer Big Rusty Drums, stick hits, close and overhead microphones, at a pinned commit; CC0-1.0, see set.json.
// Uses only the SFZ opcodes Dawsome reads; keys are MIDI numbers (C4 = 60).

<control>
default_path=samples/

<global>
loop_mode=one_shot
amp_veltrack=0

