// Choir Pad: part of dawsome-kit, written by build.py.
// From FreePats Synth Pad Choir, version 2020-05-16 (SFZ + FLAC); CC0-1.0, see set.json.
// Uses only the SFZ opcodes Dawsome reads; keys are MIDI numbers (C4 = 60).

<control>
default_path=samples/

<global>
loop_mode=loop_continuous
volume=-1.60
ampeg_release=2

<region> sample=C2.flac lokey=33 hikey=38 pitch_keycenter=36 loop_start=119520 loop_end=299518
<region> sample=F#2.flac lokey=39 hikey=44 pitch_keycenter=42 loop_start=119520 loop_end=299518
<region> sample=C3.flac lokey=45 hikey=50 pitch_keycenter=48 loop_start=119520 loop_end=299518
<region> sample=F#3.flac lokey=51 hikey=56 pitch_keycenter=54 loop_start=119520 loop_end=299518
<region> sample=C4.flac lokey=57 hikey=62 pitch_keycenter=60 loop_start=119520 loop_end=299518
<region> sample=F#4.flac lokey=63 hikey=68 pitch_keycenter=66 loop_start=119520 loop_end=299518
<region> sample=C5.flac lokey=69 hikey=74 pitch_keycenter=72 loop_start=119520 loop_end=299518
<region> sample=F#5.flac lokey=75 hikey=80 pitch_keycenter=78 loop_start=119520 loop_end=299518
<region> sample=C6.flac lokey=81 hikey=86 pitch_keycenter=84 loop_start=119520 loop_end=299518
<region> sample=F#6.flac lokey=87 hikey=91 pitch_keycenter=90 loop_start=119520 loop_end=299518
<region> sample=C7.flac lokey=92 hikey=97 pitch_keycenter=96 loop_start=119520 loop_end=299518
<region> sample=F#7.flac lokey=98 hikey=108 pitch_keycenter=102 loop_start=119520 loop_end=299518
